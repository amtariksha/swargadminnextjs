# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# This project installs with pnpm, and Vercel builds with --frozen-lockfile.
# An npm-generated package-lock.json here is not just noise: it desynchronises
# from pnpm-lock.yaml the moment a dependency is added, and can steer the
# build's package-manager detection. Keep pnpm-lock.yaml as the only lockfile.
package-lock.json
yarn.lock
